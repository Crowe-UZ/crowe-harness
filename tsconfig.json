{
  // Solution file: `tsc -b` type-checks every referenced project. Nothing is emitted
  // (each project sets noEmit; build info goes to node_modules/.tmp).
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // Only read by tooling that looks at the root config (shadcn CLI); projects define their own paths.
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
